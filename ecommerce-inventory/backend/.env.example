# Copy this file to .env and fill in your own values. NEVER commit .env to GitHub.
PORT=5000
# Local MongoDB:   mongodb://127.0.0.1:27017/ecommerce_db
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecommerce_db
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db
# Use long random strings (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_EXPIRES=15m
CLIENT_URL=http://localhost:5173
AUTH_RATE_LIMIT=30
