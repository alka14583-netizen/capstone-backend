              "const d = pm.response.json().data; pm.collectionVariables.set(\"customerToken\", d.accessToken); pm.collectionVariables.set(\"customerRefresh\", d.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
